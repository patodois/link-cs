<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 loads in Unity (Mono and IL2CPP), BepInEx, MelonLoader, .NET Framework 4.6.1+ and .NET -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>RewriteLink</AssemblyName>
    <RootNamespace>Patodois.RewriteLink</RootNamespace>
    <!-- unsafe only inside PixelFile: the seqlock needs a ref to the mapped lock word for Volatile.Read/Write -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <Version>0.1.0</Version>
    <Description>The rewrite-bridge passthrough link protocol v1 (revision 4): host and guest, for game mods in C#.</Description>
    <Authors>patodois</Authors>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
