<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0: the profile that .NET Framework 4.6.1+, Mono, Unity and .NET load. CI runs it on .NET 8 only; nothing has been
         run in Unity, BepInEx or MelonLoader (see the README). PixelFile needs a 64-bit process, and endpoint files are refused on Unix
         runtimes without a permission API. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>RewriteLink</AssemblyName>
    <RootNamespace>Patodois.RewriteLink</RootNamespace>
    <!-- unsafe only inside PixelFile: the seqlock needs a ref to the mapped lock word for Volatile.Read/Write -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <Version>0.3.0</Version>
    <Description>The rewrite-bridge passthrough link protocol v1 (revision 8): host and guest, for game mods in C#.</Description>
    <Authors>patodois</Authors>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
